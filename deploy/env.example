# .env.example — шаблон для .env

# Секретный ключ для сессий и CSRF (сгенерировать: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-64-hex-chars

# Путь к внешнему диску для бэкапов (например, /mnt/backup)
EXTERNAL_BACKUP_PATH=/mnt/backup

# (Опционально) URL базы данных. По умолчанию — SQLite рядом с проектом.
# DATABASE_URL=sqlite:///site.db
# DATABASE_URL=postgresql://user:pass@localhost/myframework